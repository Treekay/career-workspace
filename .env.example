# All relative paths resolve from career-workspace, regardless of shell cwd.
API_PORT=3001
WEB_PORT=5173
DATABASE_PATH=./data/workspace.db
EASYSEEK_PATH=../EasySeek
JOB_ALERT_WORKFLOW_PATH=../job-alert-workflow
CAREER_OPS_PATH=../career-ops
DISCOVER_STALE_HOURS=36

# Comma-separated exact origins; extensions are denied until explicitly configured.
IMPORT_EXTENSION_ORIGINS=

# Native Codex executable or PATH name; V1 uses existing local CLI authentication.
CAREER_OPS_CODEX_PATH=codex
CAREER_OPS_TIMEOUT_SECONDS=600
