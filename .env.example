# Compatibility / isolated development reference only.
# Configure normal installations in Settings / Setup Wizard, save, then restart.
# Do not copy this file as a second configuration source. Never store credentials here.
# Explicit process variables override Settings; legacy .env values are fallback only.
# WORKSPACE_CONFIG_PATH=./data/local-settings.json
# API_PORT=3001
# WEB_PORT=5173
# DATABASE_PATH=./data/workspace.db
# EASYSEEK_PATH=../EasySeek
# JOB_ALERT_WORKFLOW_PATH=../job-alert-workflow
# CAREER_OPS_PATH=../career-ops
# DISCOVER_STALE_HOURS=36
# IMPORT_EXTENSION_ORIGINS=
# CAREER_OPS_CODEX_PATH=codex
# CAREER_OPS_TIMEOUT_SECONDS=600
# CAREER_OPS_ROOT=../my-career-data
# CAREER_OPS_DATA_DIR is a legacy alias for CAREER_OPS_ROOT.
